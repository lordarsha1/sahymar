PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret

# --- داده‌ی بازار (TSETMC) ---
# سرورهای TSETMC معمولاً فقط از داخل ایران در دسترس‌اند. اگر سرور شما بیرون ایران است،
# این آدرس را روی یک رله/پروکسی داخل ایران بگذارید.
TSETMC_BASE=https://cdn.tsetmc.com/api
REFRESH_MIN=30
TSETMC_DELAY_MS=400
